# ─────────────────────────────────────────────────────────────
# Ghostty terminal configuration
# Version target: 1.3.x  (installed: 1.3.1)
# Docs:   https://ghostty.org/docs/config
# Themes: ghostty +list-themes
# Validate this file:
#   ghostty +validate-config --config-file="$(pwd)/configs/ghostty/config"
# ─────────────────────────────────────────────────────────────

# ── Language ──────────────────────────────────────────────────
# Set locale/language so CJK glyphs render without font-fallback errors
language = zh

# ── Font ──────────────────────────────────────────────────────
font-family = Maple Mono NF CN
font-size = 13
# Disable common ligatures for a cleaner coding look
font-feature = -calt,-liga,-dlig
# Use the real bold/italic faces instead of synthesized ones
font-synthetic-style = no-bold,no-italic

# ── Theme / appearance ────────────────────────────────────────
# Auto-switch with system dark/light preference
theme = dark:Catppuccin Mocha,light:Catppuccin Latte
background-opacity = 0.92
background-blur = true
cursor-style = bar
unfocused-split-opacity = 0.75

# ── Window ────────────────────────────────────────────────────
window-decoration = auto
gtk-titlebar = true
gtk-titlebar-style = native
window-padding-x = 8
window-padding-y = 4
window-save-state = default

# ── Behavior ──────────────────────────────────────────────────
shell-integration = detect
shell-integration-features = cursor,sudo,title,path
clipboard-read = ask
clipboard-write = allow
copy-on-select = true
confirm-close-surface = true
quit-after-last-window-closed = true
working-directory = inherit
mouse-hide-while-typing = true

# ── Scrollback ────────────────────────────────────────────────
# In 1.3.x this is a single byte-limit option (split into -bytes/-lines in newer tip)
scrollback-limit = 50000000

# ── Keybinds ──────────────────────────────────────────────────
# Ghostty ships sensible defaults. Below are only ADDITIONS / overrides.
# Default highlights (already active, no need to re-list):
#   ctrl+shift+,      reload_config
#   ctrl+shift+t      new_tab          ctrl+shift+w   close_tab
#   ctrl+tab          next_tab         ctrl+shift+tab previous_tab
#   ctrl+shift+o      new_split:right  ctrl+shift+e   new_split:down
#   ctrl+alt+arrow_*  goto_split:<dir>
#   ctrl+= / ctrl+-   font size        ctrl+0         reset font size
#   ctrl+shift+c/v    copy/paste       ctrl+shift+p   command palette
#   ctrl+enter        toggle_fullscreen
#
# Browser-style tab navigation (in addition to ctrl+tab)
keybind = ctrl+page_up=previous_tab
keybind = ctrl+page_down=next_tab
# macOS-style fullscreen key (in addition to ctrl+enter)
keybind = super+enter=toggle_fullscreen
